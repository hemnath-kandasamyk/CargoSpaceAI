# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# === Database ===
# Local Postgres example. If using Docker Compose, this typically points
# to the service name (e.g. "db") instead of "localhost".
DATABASE_URL=postgresql://user:password@localhost:5432/cargo_tracking

# === Auth ===
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === App ===
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
